/* Fontovi ugrađeni u stranicu (OFL licenca): rade i bez interneta, bez vanjskog servisa */
@font-face{font-family:'Manrope';font-style:normal;font-weight:400 800;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Big Shoulders Display';font-style:normal;font-weight:700 800;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Fraunces';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Fraunces';font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Fraunces';font-style:italic;font-weight:500;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
