{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/bure-meni",
      "destination": "/demo/bure-bar/",
      "permanent": false
    },
    {
      "source": "/bure-meni.html",
      "destination": "/demo/bure-bar/",
      "permanent": false
    },
    {
      "source": "/bure-rezervacije",
      "destination": "/demo/bure-bar/rezervacije/",
      "permanent": false
    },
    {
      "source": "/bure-rezervacije.html",
      "destination": "/demo/bure-bar/rezervacije/",
      "permanent": false
    },
    {
      "source": "/bure-admin",
      "destination": "/demo/bure-bar/admin/",
      "permanent": false
    },
    {
      "source": "/bure-admin.html",
      "destination": "/demo/bure-bar/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:v(qclub|kafanica|bure|brooklyn|group)/:p*",
      "destination": "/api/tt?__v=:v&__p=:p*"
    },
    {
      "source": "/studio-charm",
      "destination": "/studio-charm/index.html"
    },
    {
      "source": "/studio-charm.html",
      "destination": "/studio-charm/index.html"
    },
    {
      "source": "/osjecki-taxi",
      "destination": "/osjecki-taxi/index.html"
    },
    {
      "source": "/osjecki-taxi.html",
      "destination": "/osjecki-taxi/index.html"
    },
    {
      "source": "/taxi",
      "destination": "/taxi/index.html"
    },
    {
      "source": "/taxi-app",
      "destination": "/taxi-app/index.html"
    },
    {
      "source": "/taxi-app/statistika",
      "destination": "/taxi-app/statistika/index.html"
    },
    {
      "source": "/taxi-app/dispecer",
      "destination": "/taxi-app/dispecer/index.html"
    },
    {
      "source": "/ultra-caffe",
      "destination": "/ultra-caffe/index.html"
    },
    {
      "source": "/ultra-caffe/rezervacije",
      "destination": "/ultra-caffe/rezervacije/index.html"
    },
    {
      "source": "/ultra-caffe/uprava",
      "destination": "/ultra-caffe/uprava/index.html"
    },
    {
      "source": "/bluegym/:path+",
      "destination": "/bluegym"
    },
    {
      "source": "/:code",
      "destination": "/api/redirect?code=:code"
    }
  ],
  "regions": [
    "arn1"
  ]
}
